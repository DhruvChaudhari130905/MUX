# Copy to .env and run the server from mux/server (the file is found relative to the current directory).

# Postgres. Empty: the room actor falls back to local SQLite (./mux.db);
# the Postgres layer (checkpoints, rewind, room files) needs a real URL, e.g. from `docker compose up -d`:
#   postgresql+asyncpg://mux:mux@localhost:5433/mux
DATABASE_URL=
# Tests only; the name must contain "test" (tests/conftest.py wipes it)
TEST_DATABASE_URL=postgresql+asyncpg://mux:mux@localhost:5433/mux_test
DEBUG=false

# Token Factory (Nemotron). Check model ids with GET /v1/models
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
MODEL_LIGHTNING=
MODEL_SUPER=
MODEL_ULTRA=

# Sandbox for the coder's builds and tests: docker (default; run `make sandbox-image` with Docker
# running), nebius (Token Factory Sandboxes: also set the three below) or none
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=
SANDBOX_API_KEY=
SANDBOX_BASE_URL=

# Tavily
TAVILY_API_KEY=

# Supabase
# Projects that sign with ES256/RS256 keys are verified against SUPABASE_URL/auth/v1/.well-known/jwks.json;
# SUPABASE_JWT_SECRET is only for legacy HS256 projects.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Sends room invite emails (Supabase dashboard > Project Settings > API > service_role). Server only: never in the web app
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWT_ISSUER=
# Local development only: accept unsigned JWTs. NEVER enable in production.
ALLOW_UNVERIFIED_TOKENS=false

# GitHub OAuth (export)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Where the web app runs; connecting GitHub returns the browser here, and invite emails link here
WEB_APP_URL=http://localhost:3000

# Room secrets: MCP server tokens and the AI keys room owners save are encrypted with this Fernet key.
# Make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (MCP_ENCRYPTION_KEY, the old name, still works.)
ROOM_SECRETS_KEY=
# Local development only: let rooms use http:// and private-network addresses (an Ollama on this machine,
# a local MCP server). MCP_ALLOW_PRIVATE_URLS, the old name, still works.
ALLOW_PRIVATE_URLS=false
# Server-wide MCP servers: copy mcp.example.json to mcp.json (read at startup).
MCP_CONFIG_PATH=mcp.json
# Skill folders (each with a SKILL.md, Claude Code's format) rooms can switch on, relative to mux/server.
SKILLS_PATH=skills
